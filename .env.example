# StreamCast environment (copy to .env, then: export $(cat .env | xargs) )
# On Windows set these in the shell or leave defaults from config.py.

# Login password for the single owner. CHANGE THIS.
STREAMCAST_PASSWORD=changeme

# Flask session secret. Set to a long random string in production.
STREAMCAST_SECRET=please-change-this-to-a-random-string

# YouTube ingest base. Users only paste their stream KEY in the UI.
STREAMCAST_RTMP_BASE=rtmp://a.rtmp.youtube.com/live2

# Output format for the 24/7 stream (all uploads normalized to this).
STREAMCAST_WIDTH=1920
STREAMCAST_HEIGHT=1080
STREAMCAST_FPS=30
STREAMCAST_VBITRATE=4500k
STREAMCAST_ABITRATE=128k

# Where uploads / encoded files / db live. Defaults to ./storage.
# STREAMCAST_STORAGE=/var/lib/streamcast
