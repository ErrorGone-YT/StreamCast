# Окружение StreamCast (скопируй в .env, затем: export $(cat .env | xargs) )
# На Windows задай переменные в оболочке или оставь значения по умолчанию из config.py.

# Пароль входа для единственного владельца. ОБЯЗАТЕЛЬНО СМЕНИ.
STREAMCAST_PASSWORD=changeme

# Секрет сессий Flask. В продакшене поставь длинную случайную строку.
STREAMCAST_SECRET=please-change-this-to-a-random-string

# База приёма YouTube. В интерфейсе пользователи вставляют только КЛЮЧ трансляции.
STREAMCAST_RTMP_BASE=rtmp://a.rtmp.youtube.com/live2

# Формат выхода для 24/7-стрима (все загрузки нормализуются под него).
STREAMCAST_WIDTH=1920
STREAMCAST_HEIGHT=1080
STREAMCAST_FPS=30
STREAMCAST_VBITRATE=4500k
STREAMCAST_ABITRATE=128k

# Где лежат загрузки / кодированные файлы / БД. По умолчанию ./storage.
# STREAMCAST_STORAGE=/var/lib/streamcast
