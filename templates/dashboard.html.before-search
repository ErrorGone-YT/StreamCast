{% extends "base.html" %}
{% block title %}Streams — StreamCast{% endblock %}

{% block body %}
<div class="page-head">
  <div>
    <h1>Your streams</h1>
    <p class="subtitle" style="margin:0">Manage your 24/7 broadcasts</p>
  </div>
  <a href="{{ url_for('stream_create') }}" class="btn btn-primary">+ New stream</a>
</div>

{% if streams %}

<div style="display:flex; gap:8px; margin:20px 0; flex-wrap:wrap;">
  <button type="button" class="btn filter-btn active" data-filter="all">
    All
  </button>
  <button type="button" class="btn filter-btn" data-filter="live">
    🟢 Active
  </button>
  <button type="button" class="btn filter-btn" data-filter="offline">
    ⚪ Inactive
  </button>
</div>

<div class="grid" id="streams-grid">
  {% for s in streams %}
  <div class="stream-card stream-item"
       data-status="{{ 'live' if s.live else 'offline' }}">

    <div class="row">
      {% if s.live %}
        <span class="pill pill-live">
          <span class="pdot"></span>LIVE
        </span>
      {% else %}
        <span class="pill pill-off">
          <span class="pdot"></span>OFFLINE
        </span>
      {% endif %}

      <span class="spacer"></span>

      {% if s.scheduled_at %}
        <span class="muted" style="font-size:12px">scheduled</span>
      {% endif %}
    </div>

    <a href="{{ url_for('stream_detail', stream_id=s.id) }}"
       class="name"
       style="margin-top:12px">
      {{ s.name }}
    </a>

    <div class="stream-meta">
      <span>
        {{ s.video_count }} video{{ '' if s.video_count == 1 else 's' }}
      </span>

      {% if s.youtube_url %}
        <a href="{{ s.youtube_url }}" target="_blank">YouTube ↗</a>
      {% endif %}
    </div>

    <div style="display:flex; gap:8px; margin-top:16px;">
      <a href="{{ url_for('stream_detail', stream_id=s.id) }}"
         class="btn"
         style="flex:1; text-align:center;">
        Open
      </a>

      <form method="POST"
            action="{{ url_for('stream_delete', stream_id=s.id) }}"
            onsubmit="return confirmDelete({{ s.name|tojson|forceescape }});"
            style="margin:0;">
        <button type="submit"
                class="btn"
                style="color:#d9534f;"
                title="Delete stream">
          Delete
        </button>
      </form>
    </div>

  </div>
  {% endfor %}
</div>

<div id="no-filter-results"
     class="card empty"
     style="display:none;">
  <p>No streams match this filter.</p>
</div>

<script>
function confirmDelete(name) {
  return confirm(
    'Delete stream "' + name + '"?\\n\\n' +
    'The stream will be stopped and all uploaded videos will be deleted.'
  );
}

document.querySelectorAll('.filter-btn').forEach(function(button) {
  button.addEventListener('click', function() {

    document.querySelectorAll('.filter-btn').forEach(function(btn) {
      btn.classList.remove('active');
    });

    this.classList.add('active');

    const filter = this.dataset.filter;
    let visible = 0;

    document.querySelectorAll('.stream-item').forEach(function(item) {
      const show = filter === 'all' || item.dataset.status === filter;

      item.style.display = show ? '' : 'block';

      if (!show) {
        item.style.display = 'none';
      } else {
        visible++;
      }
    });

    document.getElementById('no-filter-results').style.display =
      visible === 0 ? 'block' : 'none';
  });
});
</script>

<style>
.filter-btn.active {
  opacity: 1;
  font-weight: 600;
}

.filter-btn:not(.active) {
  opacity: 0.7;
}
</style>

{% else %}

<div class="card empty">
  <svg width="48" height="48" viewBox="0 0 24 24"
       fill="none" stroke="currentColor" stroke-width="1.5">
    <rect x="2" y="5" width="20" height="14" rx="2"/>
    <path d="m10 9 5 3-5 3z"
          fill="currentColor"
          stroke="none"/>
  </svg>

  <p>No streams yet. Create your first 24/7 broadcast.</p>

  <a href="{{ url_for('stream_create') }}"
     class="btn btn-primary">
    + New stream
  </a>
</div>

{% endif %}
{% endblock %}
